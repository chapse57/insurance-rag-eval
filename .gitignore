# 약관 원본 PDF와 가공본은 리포에 넣지 않음 (출처만 README에 적음)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
.venv/
__pycache__/
*.pyc
.pytest_cache/
.env

# 이력서 등 개인 파일 (공개 리포에 올리지 않음)
private/

# 연습용 코드 (공식 예제 등)
scratch/

# 에이전트 실행 기록 (질문·단계별 로그)
logs/

# 실험 중간 산출물 (후보 덤프·재정렬 점수 저장·LLM 선택 저장 — 크거나 다시 만들 수 있음)
eval/results/dump_*.jsonl
eval/results/*.log
eval/cache/
eval/questions.csv.bak
